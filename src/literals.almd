// literals — where a JavaScript number, string, regular expression or
// template segment ends. Boundaries only: nothing is decoded or evaluated.
//
// Every scanner here takes the byte buffer and an offset and answers the
// offset past the literal, or a LexError at the literal's first byte. The
// driver in lexer.almd decides which scanner a byte calls for; the one
// decision it cannot make alone, whether a `/` divides or opens a regular
// expression, is made there from the token before it.
import gramide.lex

fn digit(b: Int) -> Bool = b >= 48 and b <= 57
fn hex(b: Int) -> Bool = digit(b) or (b >= 65 and b <= 70) or (b >= 97 and b <= 102)
fn ident_byte(b: Int) -> Bool = (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95 or b == 36 or digit(b) or b >= 128
fn line_end(b: Int) -> Bool = b == 10 or b == 13
// U+2028 and U+2029 are line terminators too: E2 80 A8 / E2 80 A9
fn unicode_line_end(buffer: Bytes, at: Int) -> Bool =
  bytes.get_or(buffer, at, -1) == 226 and bytes.get_or(buffer, at + 1, -1) == 128
  and (bytes.get_or(buffer, at + 2, -1) == 168 or bytes.get_or(buffer, at + 2, -1) == 169)

fn failure(line: Int, col: Int, message: String) -> lex.LexError = lex.LexError { line: line, col: col, message: message }

// ── numbers ───────────────────────────────────────────────────────────────
// 0x 0o 0b with `_` separators, legacy octal `017`, decimal with fraction and
// exponent, `.5`, `1.`, and a BigInt `n` suffix. A word glued to the end
// (`3in`) is not a number and not an identifier either.
fn starts_number(buffer: Bytes, at: Int) -> Bool =
  digit(bytes.get_or(buffer, at, -1)) or (bytes.get_or(buffer, at, -1) == 46 and digit(bytes.get_or(buffer, at + 1, -1)))

fn digits_of(buffer: Bytes, start: Int, base: Int) -> Int = {
  var i = start
  var scanning = true
  while scanning {
    let b = bytes.get_or(buffer, i, -1)
    let ok_digit = if base == 16 then hex(b) else if base == 10 then digit(b) else if base == 8 then (b >= 48 and b <= 55) else (b == 48 or b == 49)
    if ok_digit then i = i + 1
    else if b == 95 and i > start then i = i + 1
    else scanning = false
  }
  i
}

fn scan_number(buffer: Bytes, start: Int, line: Int, col: Int) -> Result[Int, lex.LexError] = {
  let error = failure(line, col, "malformed number")
  let first = bytes.get_or(buffer, start, -1)
  let second = bytes.get_or(buffer, start + 1, -1)
  let prefixed = first == 48 and (second == 120 or second == 88 or second == 111 or second == 79 or second == 98 or second == 66)
  var i = start
  if prefixed then {
    let base = if second == 120 or second == 88 then 16 else if second == 111 or second == 79 then 8 else 2
    i = digits_of(buffer, start + 2, base)
    guard i > start + 2 else err(error)
  } else {
    i = digits_of(buffer, start, 10)
    // `.5`, `1.`, `1.5`
    if bytes.get_or(buffer, i, -1) == 46 then i = digits_of(buffer, i + 1, 10) else ()
    let e = bytes.get_or(buffer, i, -1)
    if e == 101 or e == 69 then {
      let sign = bytes.get_or(buffer, i + 1, -1)
      let from = if sign == 43 or sign == 45 then i + 2 else i + 1
      let after = digits_of(buffer, from, 10)
      guard after > from else err(error)
      i = after
    } else ()
  }
  if bytes.get_or(buffer, i, -1) == 110 then i = i + 1 else ()
  guard not ident_byte(bytes.get_or(buffer, i, -1)) else err(failure(line, col, "identifier starts immediately after numeric literal"))
  ok(i)
}

// ── strings ───────────────────────────────────────────────────────────────
// `'…'` and `"…"` on one line; `\` escapes the next byte, and an escaped line
// break continues the literal.
fn scan_string(buffer: Bytes, start: Int, line: Int, col: Int) -> Result[Int, lex.LexError] = {
  let quote = bytes.get_or(buffer, start, -1)
  var i = start + 1
  var end = -1
  while end < 0 {
    let b = bytes.get_or(buffer, i, -1)
    guard b >= 0 and not line_end(b) and not unicode_line_end(buffer, i) else err(failure(line, col, "unterminated string literal"))
    if b == quote then end = i + 1
    else if b == 92 then {
      let next = bytes.get_or(buffer, i + 1, -1)
      guard next >= 0 else err(failure(line, col, "unterminated string literal"))
      i = i + (if next == 13 and bytes.get_or(buffer, i + 2, -1) == 10 then 3 else if next == 226 and unicode_line_end(buffer, i + 1) then 4 else 2)
    }
    else i = i + 1
  }
  ok(end)
}

// Where an unterminated string's line ends: what a recovering scanner marks
// as the error and skips.
fn string_recovery_end(buffer: Bytes, start: Int) -> Int = {
  var i = start + 1
  while i < bytes.len(buffer) and not line_end(bytes.get_or(buffer, i, -1)) and not unicode_line_end(buffer, i) {
    i = i + (if bytes.get_or(buffer, i, -1) == 92 and bytes.get_or(buffer, i + 1, -1) >= 0 then 2 else 1)
  }
  int.min(i, bytes.len(buffer))
}

// ── regular expressions ───────────────────────────────────────────────────
// From the opening `/` to the closing `/` and its flags. Inside `[…]` a `/`
// does not close; `\` escapes; a line break ends nothing but the literal.
fn scan_regex(buffer: Bytes, start: Int, line: Int, col: Int) -> Result[Int, lex.LexError] = {
  let error = failure(line, col, "unterminated regular expression literal")
  var i = start + 1
  var in_class = false
  var end = -1
  while end < 0 {
    let b = bytes.get_or(buffer, i, -1)
    guard b >= 0 and not line_end(b) and not unicode_line_end(buffer, i) else err(error)
    if b == 92 then {
      guard not line_end(bytes.get_or(buffer, i + 1, -1)) else err(error)
      i = i + 2
    }
    else if b == 91 then { in_class = true; i = i + 1 }
    else if b == 93 then { in_class = false; i = i + 1 }
    else if b == 47 and not in_class then end = i + 1
    else i = i + 1
  }
  // an empty body `//` is a comment, never a regex; the driver has already
  // made sure the first byte is not `/` or `*`
  var j = end
  while ident_byte(bytes.get_or(buffer, j, -1)) { j = j + 1 }
  ok(j)
}

// ── template literals ─────────────────────────────────────────────────────
// A template is scanned in segments: from a backtick or a `}` that closes a
// substitution, to the `$` `{` that opens the next one or the backtick that ends
// the literal. `kind` says which.
let SEG_OPEN = 1     // ends in `$` `{`: an expression follows
let SEG_CLOSE = 2    // ends in a backtick: the literal is over
type Segment = { kind: Int, end: Int }

fn scan_template_segment(buffer: Bytes, start: Int, line: Int, col: Int) -> Result[Segment, lex.LexError] = {
  let error = failure(line, col, "unterminated template literal")
  var i = start + 1
  var found: Option[Segment] = none
  while option.is_none(found) {
    let b = bytes.get_or(buffer, i, -1)
    guard b >= 0 else err(error)
    if b == 96 then found = some(Segment { kind: SEG_CLOSE, end: i + 1 })
    else if b == 36 and bytes.get_or(buffer, i + 1, -1) == 123 then found = some(Segment { kind: SEG_OPEN, end: i + 2 })
    else if b == 92 then {
      guard bytes.get_or(buffer, i + 1, -1) >= 0 else err(error)
      i = i + 2
    }
    else i = i + 1
  }
  option.to_result(found, error)
}

test "numbers end where the spec says, and a glued word is an error" {
  let src = bytes.from_string("0x1F_00 017 1_000.5e-3 .5 1. 10n 3in 0b12")
  assert_eq(scan_number(src, 0, 1, 1), ok(7))
  assert_eq(scan_number(src, 8, 1, 9), ok(11))
  assert_eq(scan_number(src, 12, 1, 13), ok(22))
  assert_eq(scan_number(src, 23, 1, 24), ok(25))
  assert_eq(scan_number(src, 26, 1, 27), ok(28))
  assert_eq(scan_number(src, 29, 1, 30), ok(32))
  assert(result.is_err(scan_number(src, 33, 1, 34)))
  // `0b1` then `2`: a binary literal ends before a digit it cannot hold
  assert(result.is_err(scan_number(src, 37, 1, 38)))
}

test "strings, regexes and template segments know their own ends" {
  let src = bytes.from_string("'a\\'b' \"x\\\ny\" /[/]a\\/b/gi `a\${x}b\${y}c`")
  assert_eq(scan_string(src, 0, 1, 1), ok(6))
  assert_eq(scan_string(src, 7, 1, 8), ok(13))
  assert_eq(scan_regex(src, 14, 1, 15), ok(25))
  assert_eq(scan_template_segment(src, 26, 1, 27), ok(Segment { kind: SEG_OPEN, end: 30 }))
  assert_eq(scan_template_segment(src, 31, 1, 32), ok(Segment { kind: SEG_OPEN, end: 35 }))
  assert_eq(scan_template_segment(src, 36, 1, 37), ok(Segment { kind: SEG_CLOSE, end: 39 }))
  assert(result.is_err(scan_string(bytes.from_string("'abc\n'"), 0, 1, 1)))
  assert(result.is_err(scan_regex(bytes.from_string("/abc\n/"), 0, 1, 1)))
  assert(result.is_err(scan_template_segment(bytes.from_string("`abc"), 0, 1, 1)))
}
