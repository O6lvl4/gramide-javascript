// lexer — UTF-8 JavaScript source in, tokens out.
//
// JavaScript cannot be lexed by a table, for three reasons that all come
// down to context. A `/` divides or opens a regular expression depending on
// the token before it. A template literal holds expressions that hold
// template literals. And a line break ends a statement or does not, by rules
// (automatic semicolon insertion) that look at the tokens on both sides of
// it. This scanner settles all three, so that the grammar never mentions a
// newline: a `newline` token in the stream is a statement separator and
// nothing else, exactly as in the Go package.
//
// What the scanner keeps to decide those questions is small. The class of
// the previous token (operand, punctuation, a word that an operand follows,
// a word that a statement follows, a restricted word such as `return`); a
// stack of what each open `{` is (a block, an object literal, a template
// substitution, the body of a `do`); a stack of what each open `(` is (the
// header of an `if` / `for` / `function` ..., or an ordinary group); and
// whether a line break has been seen since the previous token. Comments are
// skipped, and a block comment spanning lines is a line break.
//
// The separator rule, in one paragraph. A line break becomes a `newline`
// token when the previous token was `return`, `throw`, `break`, `continue`,
// `yield` or `debugger` (the restricted productions); or when it was an
// operand — a name, a literal, `)` of a group, `]`, the `}` of an object —
// and the next token cannot continue an expression (it is not an operator,
// a `,`, a closer, `.`, `(`, `[`, a template, `else`, `in`, ...); or when it
// was the `}` of a block and the next token is not `else`, `catch`,
// `finally`, a closer or an operator (the `while` of a `do` included). After
// anything else — an operator, an opener, the `)` of an `if` header, a
// keyword — a line break means nothing.
import gramide.tree
import gramide.lex
import self.words
import self.literals

// ── operators, packed by first byte ───────────────────────────────────────
// Longest first, so the first that matches is the longest. Each is packed
// into one integer — its bytes and its width — and grouped by first byte.
fn operator_texts(split_gt: Bool) -> List[String] = {
  let shifts = if split_gt then ([]: List[String]) else [">>>=", ">>=", ">>>", ">=", ">>"]
  shifts + [
    "...", "===", "!==", "**=", "<<=", "&&=", "||=", "??=",
    "=>", "==", "!=", "<=", "&&", "||", "??", "?.", "++", "--", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "**", "<<",
    "+", "-", "*", "/", "%", "&", "|", "^", "<", ">", "=", "!", "~", "?", ":", ".", ",", ";", "(", ")", "[", "]", "{", "}", "@"
  ]
}
type Operators = { start: List[Int], count: List[Int], packed: List[Int] }
let OP_BYTES = 256

fn pack(text: String) -> Int = {
  let raw = bytes.from_string(text)
  int.bor(int.bor(bytes.get_or(raw, 0, 0), int.bshl(bytes.get_or(raw, 1, 0), 8)),
    int.bor(int.bshl(bytes.get_or(raw, 2, 0), 16), int.bshl(bytes.len(raw), 24)))
}

fn operators(split_gt: Bool) -> Operators = {
  var all: List[Int] = []
  for text in operator_texts(split_gt) { list.push(all, pack(text)) }
  var start: List[Int] = list.with_capacity(OP_BYTES)
  var count: List[Int] = list.with_capacity(OP_BYTES)
  var packed: List[Int] = list.with_capacity(list.len(all))
  var b = 0
  while b < OP_BYTES {
    list.push(start, list.len(packed))
    var n = 0
    var k = 0
    while k < list.len(all) {
      let p = list.get(all, k) ?? 0
      if int.band(p, 255) == b then { list.push(packed, p); n = n + 1 } else ()
      k = k + 1
    }
    list.push(count, n)
    b = b + 1
  }
  Operators { start: start, count: count, packed: packed }
}

// The packed operator standing at `at`, or 0 for none. `>>>=` is four bytes;
// the fourth is checked here because the pack holds only three.
fn operator_at(ops: Operators, source: Bytes, at: Int, first: Int) -> Int = {
  if first < 0 or first >= OP_BYTES then 0 else {
    let from = list.get(ops.start, first) ?? 0
    let n = list.get(ops.count, first) ?? 0
    var found = 0
    var j = 0
    while found == 0 and j < n {
      let p = list.get(ops.packed, from + j) ?? 0
      let w = int.bshr(p, 24)
      if (w < 2 or bytes.get_or(source, at + 1, -1) == int.band(int.bshr(p, 8), 255))
        and (w < 3 or bytes.get_or(source, at + 2, -1) == int.band(int.bshr(p, 16), 255))
        and (w < 4 or bytes.get_or(source, at + 3, -1) == 61) then found = p
      else ()
      j = j + 1
    }
    found
  }
}
fn width_of(op: Int) -> Int = int.bshr(op, 24)

let OP_LPAREN = pack("(")
let OP_RPAREN = pack(")")
let OP_LBRACK = pack("[")
let OP_RBRACK = pack("]")
let OP_LBRACE = pack("{")
let OP_RBRACE = pack("}")
let OP_ARROW = pack("=>")
let OP_SEMI = pack(";")
let OP_COLON = pack(":")
let OP_QDOT = pack("?.")
let OP_AT = pack("@")
let OP_INC = pack("++")
let OP_DEC = pack("--")
let OP_NOT = pack("!")
let OP_TILDE = pack("~")
let OP_SPREAD = pack("...")
let OP_STAR = pack("*")
let OP_GT = pack(">")
let OP_LT = pack("<")

// ── what the scanner remembers ────────────────────────────────────────────
// the class of the previous token
let P_NONE = 0            // nothing yet, or a separator just went out
let P_OPERAND = 1         // a name, a literal, `)` of a group, `]`, `}` of an object
let P_PUNCT = 2           // an operator, an opener, `)` of a header, `:` ...
let P_RESTRICTED = 3      // return throw break continue yield debugger
let P_WORD_OPERAND = 4    // typeof in of new delete case await extends default
let P_WORD_STATEMENT = 5  // else do try finally if for while with switch catch function class import export
let P_BLOCK_END = 6       // `}` of a block
// what an open brace is
let B_BLOCK = 0
let B_OBJECT = 1
let B_TEMPLATE = 2
let B_DO = 3
// what an open paren is
let PAREN_PLAIN = 0
let PAREN_HEADER = 1

// After a line break, can the next token continue the expression the
// previous operand ended? Openers, templates and prefix operators cannot
// begin a continuation after an operand except `(`, `[` and a template,
// which the specification reads as a call, an index and a tag.
fn punct_starts_statement(op: Int) -> Bool =
  op == OP_LBRACE or op == OP_NOT or op == OP_TILDE or op == OP_INC or op == OP_DEC or op == OP_SPREAD or op == OP_AT
// after an operand, these words continue the expression or the declaration
fn word_continues_operand(code: Int) -> Bool =
  code == words.W_IN or code == words.W_INSTANCEOF or code == words.W_OF or code == words.W_EXTENDS
  or code == words.W_AS or code == words.W_SATISFIES
// after the `}` of a block, these words continue the statement
fn word_continues_block(code: Int, after_do: Bool) -> Bool =
  code == words.W_ELSE or code == words.W_CATCH or code == words.W_FINALLY or (code == words.W_WHILE and after_do)

// For TypeScript: does the bracket at `at` open a signature rather than an
// index or a call? `[key: string]`, `[K in T]`, `(): void`, `(x: T)`,
// `(...rest)`, `(this: T)`. In an object type a line break before one of
// these separates members, where JavaScript would read an index or a call.
fn opens_signature(buffer: Bytes, at: Int, close: Int) -> Bool = {
  var i = at + 1
  while is_space(bytes.get_or(buffer, i, -1)) { i = i + 1 }
  let b = bytes.get_or(buffer, i, -1)
  if b == close then true
  else if b == 46 and bytes.get_or(buffer, i + 1, -1) == 46 and bytes.get_or(buffer, i + 2, -1) == 46 then true
  else if not ident_start(b) then false
  else {
    let word_end = scan_word(buffer, i)
    var j = word_end
    while is_space(bytes.get_or(buffer, j, -1)) { j = j + 1 }
    let c = bytes.get_or(buffer, j, -1)
    c == 58 or (c == 63 and bytes.get_or(buffer, j + 1, -1) == 58)
      or (c == 105 and bytes.get_or(buffer, j + 1, -1) == 110 and is_space(bytes.get_or(buffer, j + 2, -1)))
  }
}

fn make(kind: Int, start: Int, end: Int, line: Int, line_start: Int) -> tree.Token =
  tree.Token { kind: kind, start: start, end: end, line: line, col: start - line_start + 1 }
fn newline_end(source: Bytes, at: Int) -> Int = at + (if bytes.get_or(source, at, -1) == 13 and bytes.get_or(source, at + 1, -1) == 10 then 2 else 1)
fn ident_start(b: Int) -> Bool = (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95 or b == 36 or b >= 128 or b == 92
fn is_space(b: Int) -> Bool = b == 32 or b == 9 or b == 11 or b == 12

// The width of a non-ASCII whitespace or the byte order mark at `at`, or 0.
fn unicode_space(buffer: Bytes, at: Int) -> Int = {
  let a = bytes.get_or(buffer, at, -1)
  let b = bytes.get_or(buffer, at + 1, -1)
  let c = bytes.get_or(buffer, at + 2, -1)
  if a == 194 and b == 160 then 2                                  // U+00A0
  else if a == 239 and b == 187 and c == 191 then 3                // U+FEFF
  else if a == 226 and b == 128 and ((c >= 128 and c <= 138) or c == 175) then 3   // U+2000..200A, U+202F
  else if a == 226 and b == 129 and c == 159 then 3                // U+205F
  else if a == 227 and b == 128 and c == 128 then 3                // U+3000
  else if a == 225 and b == 154 and c == 128 then 3                // U+1680
  else 0
}

// An identifier, from its first byte: ASCII letters, digits, `_`, `$`, any
// non-ASCII byte, and `\uXXXX` escapes. `#name` is a private name.
fn scan_word(buffer: Bytes, start: Int) -> Int = {
  var i = if bytes.get_or(buffer, start, -1) == 35 then start + 1 else start
  var scanning = true
  while scanning {
    let b = bytes.get_or(buffer, i, -1)
    if literals.ident_byte(b) then i = i + 1
    else if b == 92 and bytes.get_or(buffer, i + 1, -1) == 117 then {
      // \u{…} or \uXXXX
      if bytes.get_or(buffer, i + 2, -1) == 123 then {
        var j = i + 3
        while literals.hex(bytes.get_or(buffer, j, -1)) { j = j + 1 }
        i = if bytes.get_or(buffer, j, -1) == 125 then j + 1 else j
      } else i = i + 6
    }
    else scanning = false
  }
  i
}

// ── what a JSX element is to the scanner ──────────────────────────────────
// Inside an element the source is not JavaScript: a tag holds names that
// may contain `-`, `:` and `.`, strings without escapes, and `{ … }` around
// an expression; between tags there is text up to the next `<` or `{`.
// The scanner keeps a stack of where it is, and the grammar sees tag and
// attribute names as identifiers, attribute strings and text as strings,
// and `{` `}` around expressions.
let J_TAG = 1         // inside `<name …`, before any `/`
let J_TAG_CLOSING = 2 // inside `</name …`
let J_TAG_SELF = 3    // inside `<name … /`, waiting for `>`
let J_CHILDREN = 4    // between an opening tag and its closing tag
let J_EXPR = 5        // inside `{ … }` of a tag or of children
let J_TYPE = 6        // inside the `<…>` type arguments of a tag name (TypeScript)
let B_JSX = 4         // the `{` that opened a JSX expression

// Does the `<` at `at` open an element? It must stand where an operand may
// (the caller knows) and be followed by a name or by `>` (a fragment). In
// a .tsx file `<T,>(x) => …` and `<T extends U>(x) => …` are generic arrows,
// which the comma and the `extends` say.
fn jsx_starts(buffer: Bytes, at: Int) -> Bool = {
  let c = bytes.get_or(buffer, at + 1, -1)
  if c == 62 then true
  else if not ident_start(c) or c == 92 then false
  else {
    var j = scan_jsx_name(buffer, at + 1)
    while is_space(bytes.get_or(buffer, j, -1)) { j = j + 1 }
    let d = bytes.get_or(buffer, j, -1)
    let extends_next = bytes.get_or(buffer, j, -1) == 101 and bytes.get_or(buffer, j + 1, -1) == 120 and bytes.get_or(buffer, j + 2, -1) == 116
      and bytes.get_or(buffer, j + 3, -1) == 101 and bytes.get_or(buffer, j + 4, -1) == 110 and bytes.get_or(buffer, j + 5, -1) == 100
      and bytes.get_or(buffer, j + 6, -1) == 115 and not literals.ident_byte(bytes.get_or(buffer, j + 7, -1))
    d != 44 and not extends_next
  }
}
fn scan_jsx_name(buffer: Bytes, start: Int) -> Int = {
  var i = start
  while literals.ident_byte(bytes.get_or(buffer, i, -1)) or bytes.get_or(buffer, i, -1) == 45
    or bytes.get_or(buffer, i, -1) == 58 or bytes.get_or(buffer, i, -1) == 46 { i = i + 1 }
  i
}
fn scan_jsx_text(buffer: Bytes, start: Int) -> Int = {
  var i = start
  while i < bytes.len(buffer) and bytes.get_or(buffer, i, -1) != 60 and bytes.get_or(buffer, i, -1) != 123 { i = i + 1 }
  i
}
// a JSX attribute string: to the matching quote, no escapes, lines allowed;
// -1 when it never closes
fn scan_jsx_string(buffer: Bytes, start: Int) -> Int = {
  let quote = bytes.get_or(buffer, start, -1)
  var i = start + 1
  while i < bytes.len(buffer) and bytes.get_or(buffer, i, -1) != quote { i = i + 1 }
  if i < bytes.len(buffer) then i + 1 else -1
}

// ── the small decisions, each its own function ────────────────────────────
// the class of a word, from its code
fn word_class(code: Int) -> Int =
  if words.restricted(code) then P_RESTRICTED
  else if words.before_operand(code) then P_WORD_OPERAND
  else if words.before_statement(code) then P_WORD_STATEMENT
  else P_OPERAND

// what a `{` opens, from what came before it
fn brace_tag(prev: Int, prev_op: Int, prev_word: Int, top: Int) -> Int =
  if prev == P_NONE or prev == P_OPERAND or prev == P_BLOCK_END then B_BLOCK
  else if prev == P_RESTRICTED or prev == P_WORD_OPERAND then B_OBJECT
  else if prev == P_WORD_STATEMENT then (if prev_word == words.W_DO then B_DO else B_BLOCK)
  else if prev_op == OP_RPAREN or prev_op == OP_ARROW or prev_op == OP_SEMI or prev_op == OP_LBRACE or prev_op == OP_RBRACE then B_BLOCK
  else if prev_op == OP_COLON then (if top == B_OBJECT then B_OBJECT else B_BLOCK)
  else B_OBJECT

// does a line break before this token separate statements? `prev` is the
// class of the token before the break; the rest describes the token after
fn separates(prev: Int, kind: Int, op: Int, word: Int, after_do: Bool, split_gt: Bool, buffer: Bytes, start: Int) -> Bool = {
  let is_punct = kind == tree.T_PUNCT
  let is_word = kind == tree.T_IDENTIFIER
  if kind == tree.T_TSTRING_MIDDLE or kind == tree.T_TSTRING_END then false
  else if prev == P_RESTRICTED then true
  else if prev == P_OPERAND then
    (if is_punct then punct_starts_statement(op)
       or (split_gt and op == OP_LBRACK and opens_signature(buffer, start, 93))
       or (split_gt and op == OP_LPAREN and opens_signature(buffer, start, 41))
     else if is_word then not word_continues_operand(word)
     else kind != tree.T_TSTRING_START)
  else if prev == P_BLOCK_END then
    (if is_punct then punct_starts_statement(op) or op == OP_LPAREN or op == OP_LBRACK
     else if is_word then not word_continues_block(word, after_do)
     else true)
  else false
}

// ── the scanner ───────────────────────────────────────────────────────────
// `split_gt` is the TypeScript package's: `>` is always one token, and a `>`
// after an operand is the end of one (`Promise<void>` ends a line the way a
// name does), which a comparison at the end of a line then cannot be.
// `jsx` says a `<` where an operand may stand opens an element: on for
// JavaScript, whose files carry JSX without a different extension, and for
// .tsx; off for .ts, where `<T>x` is an assertion.
type ScanTables = { ops: Operators, word_table: words.Words, split_gt: Bool, jsx: Bool }
fn prepare(split_gt: Bool, jsx: Bool) -> ScanTables = ScanTables { ops: operators(split_gt), word_table: words.prepare(), split_gt: split_gt, jsx: jsx }

// What the scanner carries from one token to the next: the stacks, the class
// of the previous token, and the line break it has seen but not yet decided.
type State = {
  tokens: List[tree.Token],
  braces: List[Int], parens: List[Int], jsx: List[Int],
  tag_named: Bool,        // the open tag has its name: a `/` now is self-closing
  type_depth: Int,        // open `<` inside a tag's type arguments
  prev: Int, prev_op: Int, prev_word: Int, prev_was_word: Bool,
  since_function: Int,    // tokens since a `function` word, for `function name (`
  after_do: Bool,         // the previous token closed the body of a `do`
  do_pending: Bool,       // a `do` whose body is not a block: its `while` is still to come
  decorated: Bool,        // a `@` opened a decorator: the next line break joins
  nl_seen: Bool, nl_at: Int, nl_line: Int, nl_line_start: Int,
  i: Int, line: Int, line_start: Int,
}
fn fresh() -> State = State {
  tokens: [], braces: [], parens: [], jsx: [], tag_named: false, type_depth: 0,
  prev: P_NONE, prev_op: 0, prev_word: words.W_PLAIN, prev_was_word: false, since_function: 99,
  after_do: false, do_pending: false, decorated: false,
  nl_seen: false, nl_at: 0, nl_line: 1, nl_line_start: 0, i: 0, line: 1, line_start: 0,
}
// What one token's scan answers; `s.i` has moved past it. A `failure` is a
// token that could not be read whole: `recover_end` is where reading resumes.
type Step = { kind: Int, next_class: Int, op: Int, word: Int, failure: Option[lex.LexError], recover_end: Int, template_closed: Bool }
fn nothing() -> Step = Step { kind: tree.T_NONE, next_class: P_NONE, op: 0, word: words.W_PLAIN, failure: none, recover_end: -1, template_closed: false }
fn punct(op: Int) -> Step = Step { ...nothing(), kind: tree.T_PUNCT, next_class: P_PUNCT, op: op }
fn operand(kind: Int) -> Step = Step { ...nothing(), kind: kind, next_class: P_OPERAND }
fn failed(kind: Int, e: lex.LexError, recover_end: Int) -> Step = Step { ...nothing(), kind: kind, failure: some(e), recover_end: recover_end }
fn error_at(s: State, start: Int, message: String) -> lex.LexError = lex.LexError { line: s.line, col: start - s.line_start + 1, message: message }

fn note_newline(mut s: State, at: Int) -> Unit =
  if not s.nl_seen then { s.nl_seen = true; s.nl_at = at; s.nl_line = s.line; s.nl_line_start = s.line_start } else ()

// inside a tag: names, `=`, strings, `{`, `/`, `>`
fn tag_step(buffer: Bytes, n: Int, b: Int, start: Int, jmode: Int, p: ScanTables, mut s: State) -> Step =
  if b == 62 then {
    s.i = s.i + 1
    let _ = list.pop(s.jsx)
    if jmode == J_TAG then list.push(s.jsx, J_CHILDREN)
    else if jmode == J_TAG_CLOSING then { let _ = list.pop(s.jsx) }
    else ()
    Step { ...punct(OP_GT), next_class: if list.is_empty(s.jsx) then P_OPERAND else P_PUNCT }
  }
  else if b == 47 then {
    s.i = s.i + 1
    let _ = list.pop(s.jsx)
    list.push(s.jsx, if s.tag_named then J_TAG_SELF else J_TAG_CLOSING)
    punct(pack("/"))
  }
  else if b == 123 then { s.i = s.i + 1; list.push(s.jsx, J_EXPR); list.push(s.braces, B_JSX); punct(OP_LBRACE) }
  else if b == 61 then { s.i = s.i + 1; punct(pack("=")) }
  else if b == 60 and s.tag_named and p.split_gt and jmode == J_TAG then { s.i = s.i + 1; list.push(s.jsx, J_TYPE); s.type_depth = 1; punct(OP_LT) }
  else if b == 34 or b == 39 then {
    let end = scan_jsx_string(buffer, s.i)
    if end < 0 then failed(tree.T_STRING, error_at(s, start, "unterminated JSX attribute string"), n)
    else { s.i = end; Step { ...punct(0), kind: tree.T_STRING } }
  }
  else if ident_start(b) and b != 92 then { s.i = scan_jsx_name(buffer, s.i); s.tag_named = true; Step { ...punct(0), kind: tree.T_IDENTIFIER } }
  else failed(tree.T_PUNCT, error_at(s, start, "unexpected character in a JSX tag"), s.i + 1)

// between tags: `<` opens a nested or the closing tag, `{` an expression
fn children_step(b: Int, mut s: State) -> Step = {
  s.i = s.i + 1
  if b == 60 then { list.push(s.jsx, J_TAG); s.tag_named = false; punct(OP_LT) }
  else { list.push(s.jsx, J_EXPR); list.push(s.braces, B_JSX); punct(OP_LBRACE) }
}

// `/* … */`: the line breaks inside count, the first as the one seen; false
// if the comment never closes, with `s.i` at the end of the file
fn block_comment(buffer: Bytes, n: Int, mut s: State) -> Bool = {
  var j = s.i + 2
  var closed = false
  while not closed and j < n {
    let c = bytes.get_or(buffer, j, -1)
    if c == 42 and bytes.get_or(buffer, j + 1, -1) == 47 then closed = true
    else {
      if literals.line_end(c) or literals.unicode_line_end(buffer, j) then note_newline(s, j) else ()
      j = j + 1
    }
  }
  s.i = if closed then j + 2 else n
  closed
}
fn line_comment(buffer: Bytes, n: Int, mut s: State) -> Unit =
  while s.i < n and not literals.line_end(bytes.get_or(buffer, s.i, -1)) and not literals.unicode_line_end(buffer, s.i) { s.i = s.i + 1 }

fn literal_step(buffer: Bytes, n: Int, b: Int, start: Int, p: ScanTables, mut s: State) -> Step = {
  let col = start - s.line_start + 1
  if b == 34 or b == 39 then match literals.scan_string(buffer, start, s.line, col) {
    ok(end) => { s.i = end; operand(tree.T_STRING) },
    err(e) => failed(tree.T_STRING, e, literals.string_recovery_end(buffer, start)),
  }
  else if b == 96 then match literals.scan_template_segment(buffer, start, s.line, col) {
    // a template's first segment: whole, or up to its first `$` `{`
    ok(seg) => {
      s.i = seg.end
      if seg.kind == literals.SEG_OPEN then { list.push(s.braces, B_TEMPLATE); Step { ...punct(0), kind: tree.T_TSTRING_START } }
      else Step { ...operand(tree.T_TSTRING_START), template_closed: true }
    },
    err(e) => failed(tree.T_TSTRING_START, e, n),
  }
  else if b == 47 then match literals.scan_regex(buffer, start, s.line, col) {
    // a regular expression: what a `/` is unless an operand precedes it
    ok(end) => { s.i = end; operand(tree.T_STRING) },
    err(e) => failed(tree.T_STRING, e, literals.string_recovery_end(buffer, start)),
  }
  else match literals.scan_number(buffer, start, s.line, col) {
    ok(end) => { s.i = end; operand(tree.T_NUMBER) },
    err(e) => failed(tree.T_NUMBER, e, scan_word(buffer, literals.digits_of(buffer, start, 16))),
  }
}

fn word_step(buffer: Bytes, start: Int, p: ScanTables, mut s: State) -> Step = {
  s.i = scan_word(buffer, start)
  if s.i == start then failed(tree.T_IDENTIFIER, error_at(s, start, "unexpected character"), start + 1)
  else {
    let word = words.classify(p.word_table, buffer, start, s.i)
    Step { ...nothing(), kind: tree.T_IDENTIFIER, next_class: word_class(word), word: word }
  }
}

// an operator: the openers and closers keep the brace and paren stacks, and a
// `}` that closes a template substitution reads the next segment
fn operator_step(buffer: Bytes, n: Int, b: Int, start: Int, p: ScanTables, mut s: State) -> Step = {
  let op = operator_at(p.ops, buffer, start, b)
  // `?.5` is `?` then `.5`
  let op2 = if op == OP_QDOT and literals.digit(bytes.get_or(buffer, start + 2, -1)) then pack("?") else op
  guard op2 != 0 else failed(tree.T_ERROR, error_at(s, start, "unexpected character"), start + (if b >= 240 then 4 else if b >= 224 then 3 else if b >= 192 then 2 else 1))
  s.i = start + width_of(op2)
  if op2 == OP_LBRACE then {
    let tag = brace_tag(s.prev, s.prev_op, s.prev_word, list.last(s.braces) ?? B_BLOCK)
    list.push(s.braces, tag)
    if tag != B_OBJECT then s.decorated = false else ()
    punct(op2)
  }
  else if op2 == OP_RBRACE then {
    let tag = list.pop(s.braces) ?? B_BLOCK
    if tag == B_TEMPLATE then match literals.scan_template_segment(buffer, start, s.line, start - s.line_start + 1) {
      // the substitution is over: the next segment of the template
      ok(seg) => {
        s.i = seg.end
        if seg.kind == literals.SEG_OPEN then { list.push(s.braces, B_TEMPLATE); Step { ...punct(op2), kind: tree.T_TSTRING_MIDDLE } }
        else Step { ...punct(op2), kind: tree.T_TSTRING_END, next_class: P_OPERAND }
      },
      err(e) => failed(tree.T_PUNCT, e, n),
    }
    else if tag == B_JSX then { let _ = list.pop(s.jsx); punct(op2) }
    else if tag == B_OBJECT then Step { ...punct(op2), next_class: P_OPERAND }
    else { s.after_do = tag == B_DO; Step { ...punct(op2), next_class: P_BLOCK_END } }
  }
  else if op2 == OP_LPAREN then {
    let header = (words.opens_header(s.prev_word) and s.prev_was_word and not (s.prev_word == words.W_WHILE and s.after_do))
      or s.since_function <= 2
    list.push(s.parens, if header then PAREN_HEADER else PAREN_PLAIN)
    punct(op2)
  }
  else if op2 == OP_RPAREN then Step { ...punct(op2), next_class: if (list.pop(s.parens) ?? PAREN_PLAIN) == PAREN_HEADER then P_PUNCT else P_OPERAND }
  else if op2 == OP_RBRACK then Step { ...punct(op2), next_class: P_OPERAND }
  else if op2 == OP_GT and p.split_gt and (s.prev == P_OPERAND or s.prev == P_BLOCK_END) then Step { ...punct(op2), next_class: P_OPERAND }
  else punct(op2)
}

// a token outside any JSX tag or children
fn token_step(buffer: Bytes, n: Int, b: Int, start: Int, p: ScanTables, mut s: State) -> Step = {
  let after = bytes.get_or(buffer, start + 1, -1)
  if b == 34 or b == 39 or b == 96 then literal_step(buffer, n, b, start, p, s)
  else if b == 47 and s.prev != P_OPERAND and after != 42 and after != 47 then literal_step(buffer, n, b, start, p, s)
  else if p.jsx and b == 60 and s.prev != P_OPERAND and not (s.prev_was_word and (s.prev_word == words.W_FUNCTION or s.prev_word == words.W_CLASS)) and jsx_starts(buffer, start) then {
    // an element: `<` where an operand may stand, followed by a name or `>`
    s.i = start + 1
    list.push(s.jsx, J_TAG)
    s.tag_named = false
    punct(OP_LT)
  }
  else if literals.starts_number(buffer, start) then literal_step(buffer, n, 48, start, p, s)
  else if ident_start(b) or (b == 35 and ident_start(after)) then word_step(buffer, start, p, s)
  else operator_step(buffer, n, b, start, p, s)
}

// count the lines a token or comment spanned, before anything is emitted at its end
fn count_lines(buffer: Bytes, start: Int, mut s: State) -> Unit = {
  var at = start
  while at < s.i {
    let c = bytes.get_or(buffer, at, -1)
    if literals.line_end(c) then { at = newline_end(buffer, at); s.line = s.line + 1; s.line_start = at }
    else if literals.unicode_line_end(buffer, at) then { at = at + 3; s.line = s.line + 1; s.line_start = at }
    else at = at + 1
  }
}

// emit the token, with the separator before it if its line break was one,
// and carry what the next token needs to know about this one
fn finish(buffer: Bytes, step: Step, start: Int, first_line: Int, first_line_start: Int, jmode: Int, in_tag: Bool, p: ScanTables, mut s: State) -> Unit = {
  let kind = step.kind
  let is_punct = kind == tree.T_PUNCT
  let is_word = kind == tree.T_IDENTIFIER
  // the line break before this token: a separator, or nothing; inside an
  // element a line break is text or nothing
  if s.nl_seen then {
    let separate = if s.decorated or jmode == J_CHILDREN or in_tag then false
      else separates(s.prev, kind, step.op, step.word, s.after_do, p.split_gt, buffer, start)
    if s.decorated and not (is_punct and step.op == OP_AT) then s.decorated = false else ()
    if separate then list.push(s.tokens, make(tree.T_NEWLINE, s.nl_at, newline_end(buffer, s.nl_at), s.nl_line, s.nl_line_start)) else ()
    s.nl_seen = false
  } else ()
  list.push(s.tokens, make(kind, start, s.i, first_line, first_line_start))
  // the type arguments of a tag: back to the tag at the `>` that closes them
  if jmode == J_TYPE and is_punct then {
    if step.op == OP_LT then s.type_depth = s.type_depth + 1
    else if step.op == OP_GT then { s.type_depth = s.type_depth - 1; if s.type_depth == 0 then { let _ = list.pop(s.jsx) } else () }
    else ()
  } else ()
  // a template with no substitution still ends: a zero-width end marker
  if step.template_closed then list.push(s.tokens, make(tree.T_TSTRING_END, s.i, s.i, s.line, s.line_start)) else ()
  // a decorator: the line break after it joins, decided above for the
  // `@` itself and here for what follows it
  if is_punct and step.op == OP_AT then s.decorated = true else ()
  if is_word and step.word == words.W_CLASS then s.decorated = false else ()
  // the `while` of a `do`: after its body's `}`, or after a body with no braces
  if is_word and step.word == words.W_DO then s.do_pending = true
  else if is_punct and step.op == OP_LBRACE and s.prev == P_WORD_STATEMENT and s.prev_word == words.W_DO then s.do_pending = false
  else if is_word and step.word == words.W_WHILE and s.do_pending then { s.do_pending = false; s.after_do = true }
  else ()
  s.prev = step.next_class
  s.prev_op = if is_punct then step.op else 0
  // `for await (` is still the header of a `for`
  let keeps_for = step.word == words.W_AWAIT and s.prev_was_word and s.prev_word == words.W_FOR
  if is_word and not keeps_for then s.prev_word = step.word else ()
  s.prev_was_word = is_word
  s.since_function = if is_word and step.word == words.W_FUNCTION then 0
    else if s.since_function < 99 and (is_word or (is_punct and step.op == OP_STAR)) then s.since_function + 1
    else 99
  if not (is_punct and step.op == OP_RBRACE) and not (is_word and step.word == words.W_WHILE) then s.after_do = false else ()
}

fn scan_prepared(source: String, p: ScanTables, recovering: Bool) -> Result[List[tree.Token], lex.LexError] = {
  let buffer = bytes.from_string(source)
  let n = bytes.len(buffer)
  var s = fresh()
  // a shebang line is not code
  if bytes.get_or(buffer, 0, -1) == 35 and bytes.get_or(buffer, 1, -1) == 33 then line_comment(buffer, n, s) else ()
  while s.i < n {
    let b = bytes.get_or(buffer, s.i, -1)
    let start = s.i
    let first_line = s.line
    let first_line_start = s.line_start
    let jmode = list.last(s.jsx) ?? 0
    let in_tag = jmode == J_TAG or jmode == J_TAG_CLOSING or jmode == J_TAG_SELF
    let after = bytes.get_or(buffer, start + 1, -1)
    let uspace = if b >= 128 then unicode_space(buffer, start) else 0
    var step = nothing()
    if jmode == J_CHILDREN and b != 60 and b != 123 then {
      // text between tags, whitespace and all, up to the next tag or brace
      s.i = scan_jsx_text(buffer, start)
      step = Step { ...punct(0), kind: tree.T_STRING }
    }
    else if is_space(b) then s.i = start + 1
    else if uspace > 0 then s.i = start + uspace
    else if literals.line_end(b) then { note_newline(s, start); s.i = newline_end(buffer, start) }
    else if literals.unicode_line_end(buffer, start) then { note_newline(s, start); s.i = start + 3 }
    else if b == 47 and after == 47 and (in_tag or jmode != J_CHILDREN) then line_comment(buffer, n, s)
    else if b == 47 and after == 42 and (in_tag or jmode != J_CHILDREN) then {
      // a comment between attributes is skipped like any other
      if not block_comment(buffer, n, s) then {
        guard recovering else err(error_at(s, start, "unterminated block comment"))
        step = Step { ...nothing(), kind: tree.T_ERROR }
      } else ()
    }
    else if in_tag then step = tag_step(buffer, n, b, start, jmode, p, s)
    else if jmode == J_CHILDREN then step = children_step(b, s)
    else step = token_step(buffer, n, b, start, p, s)
    match step.failure {
      some(e) => {
        guard recovering else err(e)
        step = Step { ...step, kind: tree.T_ERROR, next_class: P_OPERAND }
        s.i = int.max(step.recover_end, start + 1)
      },
      none => (),
    }
    count_lines(buffer, start, s)
    if step.kind != tree.T_NONE then finish(buffer, step, start, first_line, first_line_start, jmode, in_tag, p, s) else ()
  }
  if not list.is_empty(s.braces) and (list.last(s.braces) ?? B_BLOCK) == B_TEMPLATE then {
    guard recovering else err(error_at(s, s.i, "unterminated template literal"))
  } else ()
  list.push(s.tokens, make(tree.T_EOF, s.i, s.i, s.line, s.line_start))
  ok(s.tokens)
}

fn scan(source: String, recovering: Bool) -> Result[List[tree.Token], lex.LexError] = scan_prepared(source, prepare(false, true), recovering)

// ── tests ─────────────────────────────────────────────────────────────────
fn texts(src: String) -> List[String] = texts_with(src, prepare(false, true))
fn texts_with(src: String, p: ScanTables) -> List[String] = match scan_prepared(src, p, false) {
  ok(toks) => list.map(toks, (t) => if t.kind == tree.T_NEWLINE then "⏎" else if t.kind == tree.T_EOF then "" else tree.token_text(bytes.from_string(src), t)),
  err(e) => ["LEX ERROR " + int.to_string(e.line) + ":" + int.to_string(e.col) + " " + e.message],
}

test "a slash divides after an operand and opens a regex anywhere else" {
  assert_eq(texts("a / b / c"), ["a", "/", "b", "/", "c", ""])
  assert_eq(texts("x = /a[/]b/gi.test(y)"), ["x", "=", "/a[/]b/gi", ".", "test", "(", "y", ")", ""])
  assert_eq(texts("f(a) / 2"), ["f", "(", "a", ")", "/", "2", ""])
  assert_eq(texts("if (a) /re/.test(b)"), ["if", "(", "a", ")", "/re/", ".", "test", "(", "b", ")", ""])
  assert_eq(texts("return /re/"), ["return", "/re/", ""])
  assert_eq(texts("x = {} / 2"), ["x", "=", "{", "}", "/", "2", ""])
  assert_eq(texts("{} /re/"), ["{", "}", "/re/", ""])
  assert_eq(texts("a[0] / 2"), ["a", "[", "0", "]", "/", "2", ""])
}

test "templates come out in segments around their substitutions" {
  assert_eq(texts("`plain`"), ["`plain`", "", ""])
  assert_eq(texts("`a\${x}b\${ {y: 1}.y }c`"), ["`a\${", "x", "}b\${", "{", "y", ":", "1", "}", ".", "y", "}c`", ""])
  assert_eq(texts("`\${`inner\${z}`}`"), ["`\${", "`inner\${", "z", "}`", "}`", ""])
  assert_eq(texts("tag`x`"), ["tag", "`x`", "", ""])
}

test "a line break separates statements only where the specification inserts a semicolon" {
  assert_eq(texts("a\nb"), ["a", "⏎", "b", ""])
  assert_eq(texts("a\n+ b"), ["a", "+", "b", ""])
  assert_eq(texts("a\n(b)"), ["a", "(", "b", ")", ""])
  assert_eq(texts("a\n.b"), ["a", ".", "b", ""])
  assert_eq(texts("a\n++b"), ["a", "⏎", "++", "b", ""])
  assert_eq(texts("return\nx"), ["return", "⏎", "x", ""])
  assert_eq(texts("if (a)\n  b()\nelse\n  c()"), ["if", "(", "a", ")", "b", "(", ")", "⏎", "else", "c", "(", ")", ""])
  assert_eq(texts("f(a,\n  b)"), ["f", "(", "a", ",", "b", ")", ""])
  assert_eq(texts("x = {\n  a: 1\n}\nfoo()"), ["x", "=", "{", "a", ":", "1", "}", "⏎", "foo", "(", ")", ""])
  assert_eq(texts("function f() {\n}\n(g)()"), ["function", "f", "(", ")", "{", "}", "⏎", "(", "g", ")", "(", ")", ""])
  assert_eq(texts("x = y\n{ z }"), ["x", "=", "y", "⏎", "{", "z", "}", ""])
  assert_eq(texts("do\n  x()\nwhile (y)\nz()"), ["do", "x", "(", ")", "⏎", "while", "(", "y", ")", "⏎", "z", "(", ")", ""])
  assert_eq(texts("do {\n} while (y)\nz()"), ["do", "{", "}", "while", "(", "y", ")", "⏎", "z", "(", ")", ""])
  assert_eq(texts("try {\n} catch (e) {\n} finally {\n}\nnext()"), ["try", "{", "}", "catch", "(", "e", ")", "{", "}", "finally", "{", "}", "⏎", "next", "(", ")", ""])
  assert_eq(texts("@dec\nclass A {\n  x = 1\n  y = 2\n}"), ["@", "dec", "class", "A", "{", "x", "=", "1", "⏎", "y", "=", "2", "}", ""])
  assert_eq(texts("async\nfunction f() {}"), ["async", "⏎", "function", "f", "(", ")", "{", "}", ""])
  assert_eq(texts("x\n`t`"), ["x", "`t`", "", ""])
  assert_eq(texts("/* a\n b */ x\ny"), ["x", "⏎", "y", ""])
}

test "numbers, private names, unicode and the shebang" {
  assert_eq(texts("#!/usr/bin/env node\nlet x = 1_0n + .5"), ["let", "x", "=", "1_0n", "+", ".5", ""])
  assert_eq(texts("this.#count++"), ["this", ".", "#count", "++", ""])
  assert_eq(texts("const 日本 = \\u0041bc; a?.b ?? c ? .5 : d"), ["const", "日本", "=", "\\u0041bc", ";", "a", "?.", "b", "??", "c", "?", ".5", ":", "d", ""])
  assert_eq(texts("x >>>= 1; y >>> 2; z >> 3"), ["x", ">>>=", "1", ";", "y", ">>>", "2", ";", "z", ">>", "3", ""])
}

test "an unterminated literal is an error, or in recovery one error token on its line" {
  assert(result.is_err(scan("x = 'abc\ny = 1", false)))
  assert(result.is_err(scan("x = `abc", false)))
  assert(result.is_err(scan("x = 3in", false)))
  match scan("x = 'abc\ny = 1", true) {
    ok(toks) => assert_eq(lex.kinds(toks), ["identifier", "punct", "error", "newline", "identifier", "punct", "number", "eof"]),
    err(_) => assert(false),
  }
}

test "an element is scanned as tags, names, strings and text, and ends as an operand" {
  assert_eq(texts("x = <div className=\"a b\" {...p} on={f}>hi {n} there</div>\ny"),
    ["x", "=", "<", "div", "className", "=", "\"a b\"", "{", "...", "p", "}", "on", "=", "{", "f", "}", ">", "hi ", "{", "n", "}", " there", "<", "/", "div", ">", "⏎", "y", ""])
  assert_eq(texts("<><A.B data-x='1' /></>"), ["<", ">", "<", "A.B", "data-x", "=", "'1'", "/", ">", "<", "/", ">", ""])
  assert_eq(texts("a < b\nf<T>(x)\n<T,>(x) => x\n<T extends U>(x) => x"),
    ["a", "<", "b", "⏎", "f", "<", "T", ">", "(", "x", ")", "<", "T", ",", ">", "(", "x", ")", "=>", "x", "<", "T", "extends", "U", ">", "(", "x", ")", "=>", "x", ""])
  assert_eq(texts("f = function <T>(a) { return a }\nclass<T> {}"),
    ["f", "=", "function", "<", "T", ">", "(", "a", ")", "{", "return", "a", "}", "⏎", "class", "<", "T", ">", "{", "}", ""])
  assert_eq(texts("return (\n  <ul>\n    {items.map(i => <li key={i}>{i}</li>)}\n  </ul>\n)"),
    ["return", "(", "<", "ul", ">", "\n    ", "{", "items", ".", "map", "(", "i", "=>", "<", "li", "key", "=", "{", "i", "}", ">", "{", "i", "}", "<", "/", "li", ">", ")", "}", "\n  ", "<", "/", "ul", ">", ")", ""])
}

test "a tag's type arguments are read as TypeScript, then the tag goes on" {
  assert_eq(texts_with("<Select<string[]> multiple value={v}>{c}</Select>", prepare(true, true)),
    ["<", "Select", "<", "string", "[", "]", ">", "multiple", "value", "=", "{", "v", "}", ">", "{", "c", "}", "<", "/", "Select", ">", ""])
  assert_eq(texts_with("<R<Map<K, V> | false> type=\"button\" />", prepare(true, true)),
    ["<", "R", "<", "Map", "<", "K", ",", "V", ">", "|", "false", ">", "type", "=", "\"button\"", "/", ">", ""])
}
